# Copy to .env.local for development or .env.production for production.
# .env.production is gitignored. Add the same values to the Vercel Production
# dashboard BEFORE building/deploying; Next.js embeds NEXT_PUBLIC_* at build time.

# HTTPS app URL in production; localhost only for development.
APP_URL=http://localhost:3000

# Supabase Dashboard > Connect/API keys. Use a separate project for staging.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (or legacy service_role key).
# Never prefix this with NEXT_PUBLIC_. Used for private media/cleanup/health.
SUPABASE_SECRET_KEY=

# Groq Dashboard > API Keys. Optional for manual expense entry, required for OCR.
GROQ_API_KEY=
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Strong random value (at least 32 characters); Vercel sends Bearer auth to cron.
CRON_SECRET=

# Deployment CLI credentials below are OPTIONAL and are not application config.
# Uncomment only for provisioning from your machine. Do not upload these to Vercel.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=

# Configure Google OAuth and SMTP directly in Supabase Auth dashboard.
# These are not read by the Next.js application. If providing to a deploy agent,
# use this gitignored env file instead of chat, and do not import them to Vercel.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME=Chia tiền văn phòng
