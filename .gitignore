# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# Supabase CLI local state
/supabase/.temp/
/supabase/.branches/

# local libSQL fallback DB (dev/tests when TURSO_DATABASE_URL is unset)
/local.db
/local.db-*

# local-dev photo storage (plan §4)
/public/uploads/*
!/public/uploads/.gitkeep

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e artifacts
/e2e.db
/e2e.db-*
/.e2e-uploads/

# tesseract.js language model cache (downloaded at runtime)
/eng.traineddata
/*.traineddata

# ocr-compare python venv (951MB; recreate via pip install -r, see scripts/ocr-compare/README.md)
/scripts/ocr-compare/.venv/

# macOS custom folder-icon junk
Icon?

# Claude Code machine-local settings
.claude/settings.local.json
.claude/launch.json
